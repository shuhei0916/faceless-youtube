{
    "manifest_version": 3,
    "name": "Faceless YouTube",
    "version": "1.0",
    "description": "顔認識とモザイク処理をYouTubeに適用",
"permissions": [
  "activeTab"
],
"host_permissions": [
  "https://www.youtube.com/*",
  "https://i.ytimg.com/*"
],
"content_scripts": [
  {
    "matches": [
      "https://www.youtube.com/*"
    ],
    "js": [
      "assets/face-api.js",
      "src/content/content_script.js"
    ]
  }
],
"action": {
  "default_popup": "src/popup/popup.html"
},
"web_accessible_resources": [
  {
    "resources": [
      "assets/weights/*"
    ],
    "matches": [
      "https://www.youtube.com/*"
    ]
  }
]
  }
